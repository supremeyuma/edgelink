# Copy to .dev.vars for `wrangler dev` (never commit real values).

# Bearer token required by every /v1 admin route.
ADMIN_TOKEN=local-admin-token

# Salt for HMAC-SHA256 IP hashing. Rotate monthly in production.
IP_HASH_SALT=local-ip-hash-salt

# Optional: "development" | "production"
ENVIRONMENT=development
